# ==========================================
# Base de datos (Neon PostgreSQL)
# ==========================================
# Cadena de conexion de Neon. Usar el pooled connection string para runtime
# y DIRECT_URL (no pooled) para migraciones de Prisma si Neon lo requiere.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require&channel_binding=require"

# ==========================================
# Servidor
# ==========================================
PORT=4000
NODE_ENV=development

# URL del frontend permitido por CORS (Vercel en produccion)
FRONTEND_URL="http://localhost:5173"

# ==========================================
# Autenticacion
# ==========================================
JWT_SECRET="cambia-este-secreto"
JWT_EXPIRES_IN="8h"
COOKIE_SECRET="cambia-este-secreto"

# ==========================================
# Cloudinary (logos e imagenes, NUNCA PDFs)
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==========================================
# Semilla / administrador inicial (solo desarrollo)
# ==========================================
# Usuario (no correo) del administrador creado por prisma/seed.js
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"
